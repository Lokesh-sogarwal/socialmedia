# --- Core ---
NODE_ENV=development
PORT=4000
# Primary database (MongoDB). Atlas example: mongodb+srv://<user>:<password>@<cluster>/socio
MONGODB_URI=mongodb://127.0.0.1:27017/socio
# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Public URL of this API (used to build local media URLs)
PUBLIC_SERVER_URL=http://localhost:4000
# Public URL of the web app (used in email links)
APP_URL=http://localhost:5173

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Production with the client on a different domain: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (Render/Heroku: 1)
TRUST_PROXY=0

# --- Media storage: local | cloudinary ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (optional in development: links are logged when SMTP is unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Socio <no-reply@example.com>

LOG_LEVEL=info
# Only for local end-to-end runs; refused when NODE_ENV=production
RATE_LIMIT_DISABLED=false
